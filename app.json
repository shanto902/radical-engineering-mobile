{
  "expo": {
    "name": "Radical Engineering",
    "slug": "radical-engineering-mobile",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "native",
          "backgroundColor": "#3c1100"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.radicalengineering.bd"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3c1100"
      },
      "package": "com.radicalengineering.bd",
      "versionCode": 8,
      "permissions": ["INTERNET"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "radicalengineering",
    "extra": {
      "apiBaseUrl": "https://admin.atiar.com.bd",
      "hotline1": "+880 1760195100",
      "hotline2": "+880 1787224460",
      "email": "radicalengineeringbd@gmail.com",
      "address": "1400, Hazi Hasen Ali Market, Station Road, Kishoreganj, Bangladesh",
      "eas": {
        "projectId": "efa419a6-6903-4c47-974b-286fd6e8a9de"
      }
    },
    "owner": "ashik-shanto"
  }
}
